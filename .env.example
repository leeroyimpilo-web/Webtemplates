# Use your PEND Supabase project, not a database used by another app.
# Supabase Project settings -> Connect -> Project URL + publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Reserved for Phase 1: consume only in trusted server routes / build configuration.
# Do not expose TURN credentials via NEXT_PUBLIC_ variables.
TURN_URL=
TURN_USER=
TURN_PASS=
